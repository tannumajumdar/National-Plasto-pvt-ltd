# =====================================================================
#  NATIONAL PLASTO — PRODUCTION ENVIRONMENT
#
#  Copy to .env on the server (or paste into your host's dashboard) and
#  fill every value marked CHANGE. Do NOT commit the filled-in file.
#
#  Anything left at its development value will break something specific;
#  the comment on each line says what.
# =====================================================================

# ---- Database -------------------------------------------------------
# CHANGE. The dev value points at MySQL on this laptop, which does not
# exist on a server. Use the production host, and a dedicated user —
# never root. Special characters in the password must be URL-encoded
# (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL="mysql://np_app:URL_ENCODED_PASSWORD@db-host:3306/national_plasto"

# ---- Auth -----------------------------------------------------------
# CHANGE. Generate a fresh one ON THE SERVER — never paste a real secret
# into this file: it is committed to git, so anything written here is public.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this invalidates every existing session, which is exactly what
# you want when moving to production.
JWT_SECRET="GENERATE_A_NEW_ONE_ON_THE_SERVER"
SESSION_COOKIE_NAME="np_session"

# ---- Site -----------------------------------------------------------
# CHANGE — this one matters more than it looks. It is used for:
#   password-reset links in email, order-confirmation links,
#   canonical URLs, sitemap.xml, robots.txt, and OG images.
# Leave it as localhost and reset emails will point at localhost:3000
# and Google will index the wrong host.
# No trailing slash. Must include https://
NEXT_PUBLIC_SITE_URL="https://www.nationalplasto.com"
NEXT_PUBLIC_SITE_NAME="National Plasto Pvt. Ltd."

# ---- Seed admin -----------------------------------------------------
# Only read by `npm run db:seed`, once. CHANGE the password before
# seeding a production database, or rotate it straight after with:
#   npm run set-admin-password -- 'YourStrongPassword1'
SEED_ADMIN_EMAIL="admin@nationalplasto.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_BEFORE_SEEDING"

# ---- Payments (Razorpay) -------------------------------------------
# Keep false until the client supplies live keys and you have tested a
# real transaction. NEXT_PUBLIC_RAZORPAY_KEY_ID must be the SAME value
# as RAZORPAY_KEY_ID — one is server-side, one is exposed to the browser.
PAYMENTS_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Only if you register a webhook. This is a DIFFERENT secret from the
# key secret above — copy it from Razorpay's webhook settings page.
RAZORPAY_WEBHOOK_SECRET=""

# ---- Email ----------------------------------------------------------
# CHANGE. "console" only logs to the server console — password-reset
# links would never reach a customer. Use resend or brevo.
# The from-address domain must be verified with the provider.
EMAIL_PROVIDER="resend"
EMAIL_FROM="National Plasto <orders@nationalplasto.com>"
RESEND_API_KEY=""
BREVO_API_KEY=""
# Where contact-form enquiries are forwarded. Blank = admin inbox only.
CONTACT_NOTIFY_EMAIL="sales@nationalplasto.com"

# ---- Uploads --------------------------------------------------------
# Product images are written to disk here. On a host with an ephemeral
# filesystem (Vercel, most containers) these are LOST on redeploy —
# see section 12 of the README before choosing where to host.
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB="5"

# ---- Test harness ---------------------------------------------------
# MUST stay 0 (or be deleted entirely). The route it enables also
# refuses to run when NODE_ENV=production, but do not rely on one guard:
# delete src/app/api/e2e-harness/route.ts before deploying.
E2E_HARNESS="0"
