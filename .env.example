# Development template. Copy to .env and adjust.
#
# For production, start from .env.production.example instead — it lists
# every value that MUST change and what breaks if it does not.

# ---- Database (MySQL) ----
DATABASE_URL="mysql://root:@localhost:3306/national_plasto"

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"
SESSION_COOKIE_NAME="np_session"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="National Plasto Pvt. Ltd."

# ---- Seed admin (used once by `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@nationalplasto.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# ---- Payments (Razorpay) ----
# The integration is fully implemented. Set all four and restart to enable it.
# NEXT_PUBLIC_RAZORPAY_KEY_ID must be the SAME value as RAZORPAY_KEY_ID.
PAYMENTS_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Only needed if you register a Razorpay webhook. This is a DIFFERENT secret
# from RAZORPAY_KEY_SECRET — copy it from the Razorpay webhook settings page.
RAZORPAY_WEBHOOK_SECRET=""

# ---- Email ----
# EMAIL_PROVIDER: console (default, logs only) | resend | brevo
EMAIL_PROVIDER="console"
EMAIL_FROM="National Plasto <orders@nationalplasto.com>"
RESEND_API_KEY=""
BREVO_API_KEY=""
# Where contact-form enquiries are forwarded. Blank = inbox only.
CONTACT_NOTIFY_EMAIL=""

# ---- Uploads ----
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB="5"

# ---- Test harness (dev only) ----
# Enables src/app/api/e2e-harness/route.ts so `npm run e2e` can call the
# admin server actions. Keep 0 in production AND delete that route file
# before deploying.
E2E_HARNESS="0"
