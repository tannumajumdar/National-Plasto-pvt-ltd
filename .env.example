# ---- Database (MySQL) ----
DATABASE_URL="mysql://root:@localhost:3306/national_plasto"

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"
SESSION_COOKIE_NAME="np_session"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="National Plasto Pvt. Ltd."

# ---- Seed admin (used once by `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@nationalplasto.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# ---- Payments (Razorpay) ----
# Leave PAYMENTS_ENABLED=false until real keys are supplied.
PAYMENTS_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Uploads ----
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB="5"
